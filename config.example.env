# Copy this file to .env and fill in your own values.
# .env is loaded automatically by agent.py — never commit it or share it.

# --- Ollama ---
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_NAME=my-agent
# How long Ollama keeps the model loaded in RAM between calls. "-1" = forever
# (best if this box is dedicated to the agent); "10m" = unload after 10 min idle.
OLLAMA_KEEP_ALIVE=10m
# Read timeout (seconds) for one Ollama call. Raise this if you're on a slow
# CPU-only box and see timeouts on long replies.
OLLAMA_TIMEOUT=180
# Retries for transient connection/timeout failures only (e.g. Ollama still
# starting up) — never retries a reply Ollama actually returned.
OLLAMA_MAX_RETRIES=2
# Safety cap on tool-call loops per turn before the agent gives up and answers
# with whatever it has.
MAX_TOOL_STEPS=8

# --- Conversation management ---
# Rolling window of recent messages kept before we compress older ones into a
# summary. Lower = less memory/slower drift but worse recall of earlier turns.
MAX_CONTEXT_MESSAGES=20

# --- Session logging ---
# Directory where timestamped .jsonl session logs are written (secrets redacted).
LOG_DIR=logs

# --- Shell command policy ---
# Comma-separated allowlist: these run without a confirmation prompt.
SHELL_ALLOWLIST=ls,pwd,whoami,date,uptime,echo,cat,head,tail,wc,git status
# Comma-separated denylist: these are always blocked (never run).
SHELL_DENYLIST=rm,dd,mkfs,chmod,chown,shutdown,reboot,halt,sudo,su,mount,umount,fdisk,parted

# --- Home Assistant ---
# HA_URL: base URL of your Home Assistant instance (no trailing slash)
HA_URL=http://homeassistant.local:8123
# HA_TOKEN: create a Long-Lived Access Token in Home Assistant:
#   Profile (bottom left) -> Security -> Long-Lived Access Tokens -> Create Token
HA_TOKEN=paste_your_long_lived_token_here
# Require a manual "yes" before every Home Assistant action (turn on/off, set temp).
# Set to false once you trust it, for instant responses.
HA_REQUIRE_CONFIRM=true

# Optional: a comma-separated map of friendly device names to entity IDs, used
# by the agent as a fast hint before it lists entities from Home Assistant.
# Example: HA_ENTITY_MAP=living room light=light.living_room, bedroom ac=climate.bedroom_ac

# --- Voice ---
# STT model size for faster-whisper: tiny, base, small, medium, large-v3
# bigger = more accurate but slower. "base" is a good starting point.
WHISPER_MODEL=base
# Force the recognized language instead of letting Whisper auto-detect it —
# stops accented speech from occasionally being mis-detected as a different
# language mid-recording, which produces garbled transcriptions.
WHISPER_LANGUAGE=en
# How many candidate transcriptions Whisper considers before picking one.
# Higher = more accurate (helps with accents) but slower. 5 is a solid default;
# try 8-10 if you're still seeing misheard commands.
WHISPER_BEAM_SIZE=5
# Trims silence before transcribing — usually improves accuracy.
WHISPER_VAD_FILTER=true
# How many seconds to record when you press Enter to talk
RECORD_SECONDS=5
# Shorter window used just for yes/no confirmations (faster, less waiting)
CONFIRM_RECORD_SECONDS=3

# Path to the piper TTS binary (download from https://github.com/rhasspy/piper/releases)
PIPER_BINARY=/usr/local/bin/piper
# Path to a piper voice model (.onnx), download from
# https://github.com/rhasspy/piper/blob/master/VOICES.md
PIPER_MODEL=/home/claude/local-agent/voices/en_US-lessac-medium.onnx

# --- Always-listening (wake word) mode: `python3 agent.py --wake` ---
# openWakeWord ships pretrained models: hey_jarvis, alexa, hey_mycroft, etc.
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Face recognition (enroll_face.py / presence.py) ---
FACE_DATA_PATH=face_data.pkl
CAMERA_INDEX=0
# How often (seconds) presence.py checks the camera for a face
FACE_CHECK_INTERVAL=2
# Lower = stricter match (fewer false positives, more false negatives)
FACE_TOLERANCE=0.6
# Entity ID of the light to turn on when you're recognized walking in
ENTRY_LIGHT_ENTITY=light.entryway
WELCOME_MESSAGE=Welcome home!
# Don't re-trigger the welcome for this many seconds after the first one
WELCOME_COOLDOWN_SECONDS=600

# --- Memory (facts remembered across sessions) ---
# JSON file the agent uses to store what it remembers about you.
MEMORY_PATH=memory_store/facts.json

# --- Vision (optional) ---
# Set this to a vision-capable Ollama model you've pulled (e.g. qwen2.5vl:7b
# or llava) and run `python3 agent.py --vision` to enable describe_scene.
# Leave empty to keep vision disabled.
VISION_MODEL=

# --- RAG knowledge base ---
# Folder your own documents live in (text/markdown/csv). Drop notes here and
# the agent can search and answer from them. Pull the embedding model once:
#   ollama pull nomic-embed-text
# If the embedding model is unavailable it falls back to keyword search.
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_INDEX=knowledge/index.pkl
EMBED_MODEL=nomic-embed-text
# Comma-separated extensions to load from KNOWLEDGE_DIR.
KNOWLEDGE_EXTS=.txt,.md,.markdown,.csv

# --- Server (HTTP/API service: python3 -m server.server) ---
# The machine that hosts the AI + voice + Home Assistant. Reachable by other
# machines on the LAN if you set 0.0.0.0; local-only if 127.0.0.1.
SERVER_HOST=0.0.0.0
SERVER_PORT=8899
# Shared secret clients must send as `Authorization: Bearer <token>`.
# Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SERVER_TOKEN=

# --- SSH control of a laptop (optional, from the server) ---
# Lets the server run shell/file commands on a laptop over SSH. Must set up a
# key first — see client/connect_laptop.sh.
SSH_TARGET=
SSH_KEY=
SSH_PORT=22
# Colons-separated dirs on the laptop the agent may read/write.
SSH_ALLOWED_DIRS=
